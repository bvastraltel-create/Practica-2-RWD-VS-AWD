<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Catálogo Hardware - Versión RWD</title>
  <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>
  <header class="header">
    <h1>DataCenter Hardware Catalog (RWD)</h1>
    <nav class="nav">
      <a href="#cat">Catálogo</a>
      <a href="#stats">Gráficos</a>
    </nav>
  </header>

  <div class="layout-container">
    <aside class="sidebar">
      <h3>Filtros Avanzados</h3>
      <!-- Botón visible en móviles para colapsar filtros -->
      <button class="filter-toggle" id="toggle-filters">
        <span>Filtros Avanzados</span>
        <span class="icon">▼</span>
      </button>

      <!-- Panel colapsable de filtros -->
      <div class="filter-content" id="filter-content">
        <div class="filter-group">
          <label><input type="checkbox"> Solo Serie 40</label><br>
          <label><input type="checkbox"> > 16 GB VRAM</label>
        </div>

        <!-- Gráfico Pesado  -->
        <section class="heavy-chart" id="stats">
          <h4>Comparativa de Rendimiento</h4>
          <div class="chart-container">
            <svg viewBox="0 0 300 180" class="chart-svg">
              <rect width="300" height="180" fill="#1a202c" rx="6"/>
              <text x="10" y="30" fill="#a0aec0" font-size="10">RTX 4090</text>
              <rect x="80" y="18" width="200" height="15" fill="#4299e1" rx="3"/>
              
              <text x="10" y="70" fill="#a0aec0" font-size="10">RTX 4080S</text>
              <rect x="80" y="58" width="125" height="15" fill="#319795" rx="3"/>
              
              <text x="10" y="110" fill="#a0aec0" font-size="10">RTX 4070TiS</text>
              <rect x="80" y="98" width="103" height="15" fill="#ed8936" rx="3"/>

              <text x="10" y="150" fill="#a0aec0" font-size="10">RTX 4060</text>
              <rect x="80" y="138" width="37" height="15" fill="#e53e3e" rx="3"/>
            </svg>
          </div>
        </section>
      </div>
    </aside>

    <main class="catalog-grid" id="cat">
      <% products.forEach(p => { %>
        <article class="card">
          <picture>
            <source media="(max-width: 639px)" srcset="<%= p.image %>.webp" type="image/webp">
            <img src="<%= p.image %>.jpg" alt="<%= p.name %>" class="card-img" loading="lazy">
          </picture>
          <div class="card-body">
            <h3><%= p.name %></h3>
            <ul class="specs">
              <li><strong>VRAM:</strong> <%= p.specs.vram %></li>
              <li><strong>Bus:</strong> <%= p.specs.bus %></li>
              <li><strong>CUDA Cores:</strong> <%= p.specs.cuda %></li>
              <li><strong>TDP:</strong> <%= p.specs.tdp %></li>
            </ul>
            <div class="card-footer">
              <span class="price"><%= p.price %></span>
              <button class="btn-buy">Comprar</button>
            </div>
          </div>
        </article>
      <% }); %>
    </main>
  </div>

  <script>
    document.getElementById('toggle-filters').addEventListener('click', function() {
      const content = document.getElementById('filter-content');
      content.classList.toggle('open');
      this.classList.toggle('active');
    });
  </script>
</body>
</html>